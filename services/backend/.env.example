# Required for Firestore and Firebase Authentication token verification.
# Download this private JSON key from Firebase Console > Project settings > Service accounts.
FIREBASE_SERVICE_ACCOUNT=F:/SIC/secrets/firebase-service-account.json

# Leave blank for the MVP. Images will remain on this laptop.
FIREBASE_STORAGE_BUCKET=

AI_ENABLED=true
MODEL_NAME=buffalo_sc
MODEL_ROOT=./models
FACE_DET_SIZE=320
MATCH_THRESHOLD=0.45
MATCH_MARGIN=0.06
ENROLLMENT_CONSISTENCY_THRESHOLD=0.60
RECOGNITION_CONFIRMATIONS=3
RECOGNITION_WINDOW_SECONDS=12
UNKNOWN_CONFIRMATIONS=2
UNKNOWN_IMAGE_RETENTION_DAYS=30

# Private laptop dataset. This directory is ignored by Git.
DATA_DIR=./data
SAVE_ENROLLMENT_IMAGES=true

# Generate a long random value and use the same value on the Raspberry Pi.
DEVICE_API_KEY=replace-with-a-long-random-secret

DEPLOYMENT_TIMEZONE=Asia/Ho_Chi_Minh
ATTENDANCE_COOLDOWN_SECONDS=300
UNKNOWN_COOLDOWN_SECONDS=30
USER_REFRESH_SECONDS=60
MAX_FRAME_BYTES=4194304

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,https://sicccc-30fed.firebaseapp.com,https://sicccc-30fed.web.app,https://sic4b.io.vn

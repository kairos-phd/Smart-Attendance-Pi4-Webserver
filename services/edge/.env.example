# Firebase service-account JSON must be outside Git and readable only by the service account.
# Optional if BACKEND_API_URL is configured for centralized AI ingestion mode.
FIREBASE_SERVICE_ACCOUNT=/opt/smart-attendance/secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=

# Centralized AI Server Ingestion (Remote Mode / Offload AI from Pi to Server)
# Point to your 24/7 AI server (e.g. http://192.168.1.100:8000 or http://10.0.0.1:8000)
# Leave blank to run standalone on-device AI inference
BACKEND_API_URL=
DEVICE_API_KEY=9db2af2be76cf252028e979ad53fa0ad190101c0fa3c5014c609020a8aeb341f

PI_ID=pi-classroom-01

# Dynamic camera configuration (supports 1, 2, or 3 cameras)
# Set CAMERAS_COUNT to 1, 2, or 3 (or enable/disable individually)
CAMERAS_COUNT=3

CAMERA_1_ID=camera-1
CAMERA_1_NAME=Entrance camera
CAMERA_1_SOURCE=0
CAMERA_1_ENABLED=true

CAMERA_2_ID=camera-2
CAMERA_2_NAME=Desk camera
CAMERA_2_SOURCE=1
CAMERA_2_ENABLED=true

CAMERA_3_ID=camera-3
CAMERA_3_NAME=Exit camera
CAMERA_3_SOURCE=2
CAMERA_3_ENABLED=true

# Start conservatively; tune only from measurements on the Pi.
FRAME_WIDTH=640
FRAME_HEIGHT=480
MONITOR_FPS=4
MOTION_MIN_AREA=1800
CAMERA_COOLDOWN_SECONDS=4
ATTENDANCE_COOLDOWN_SECONDS=300
MATCH_THRESHOLD=0.45
FACE_DET_SIZE=320
MODEL_NAME=buffalo_sc
MODEL_ROOT=./models
USER_REFRESH_SECONDS=120
QUEUE_RETRY_SECONDS=15
SAVE_UNKNOWN_IMAGES=true
DATA_DIR=./data
LOG_LEVEL=INFO

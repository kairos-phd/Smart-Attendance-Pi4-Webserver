VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Laptop FastAPI URL used by `npm run dev` on the same computer.
VITE_API_BASE_URL=http://localhost:8000
# Production deployment on https://sic4b.io.vn (uncomment or use .env.production):
# VITE_API_BASE_URL=https://api.sic4b.io.vn

# Media gateway can run independently of the attendance API.
# Leave unset to use VITE_API_BASE_URL for existing combined deployments.
# VITE_PI_API_BASE_URL=https://sic4b.io.vn
# PC gateway serves the website and proxies attendance on the same origin:
# VITE_API_BASE_URL=https://sic4b.io.vn/attendance-api

# WebRTC signaling uses the website Auth project's RTDB, never a service credential.
# Configure the same URL on the gateway and Pi media service.
VITE_FIREBASE_DATABASE_URL=

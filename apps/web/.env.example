VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Laptop FastAPI URL used by `npm run dev` on the same computer.
VITE_API_BASE_URL=http://localhost:8000
# Production deployment on https://sic4b.io.vn (uncomment or use .env.production):
# VITE_API_BASE_URL=https://api.sic4b.io.vn

# Optional Pi WebRTC signaling; same Firebase project/auth as Pi, never a service credential.
VITE_FIREBASE_DATABASE_URL=https://sic4b-smart-attendance-default-rtdb.asia-southeast1.firebasedatabase.app
